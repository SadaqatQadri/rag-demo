# Copy this file to .env and fill it in. Never commit .env — it holds a real key.

# From https://console.groq.com/keys (or use an OpenAI key with the OpenAI client).
GROQ_API_KEY=

# Optional. Check https://console.groq.com/docs/models for current model IDs.
GROQ_MODEL=openai/gpt-oss-20b

# --- Per-client settings: change these two and the bot is repointed ---
COMPANY_NAME=Northwind Gear Co.
FALLBACK_MESSAGE=I don't have that in the documents I've been given — please contact the support team.

# --- Rate limits. The bot runs on the client's API key, so these protect their bill. ---
MAX_QUESTIONS_PER_SESSION=30
MAX_QUESTIONS_PER_DAY=500

# For deploying to Hugging Face Spaces. Write-scoped token from
# huggingface.co -> avatar -> Access Tokens -> Create new token -> type: Write
HF_TOKEN=
